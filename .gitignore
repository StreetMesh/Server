/vendor

# Laravel Cloud API tokens. This repository is public and `composer split`
# publishes it to six more, so a credential landing here is a credential
# published six times.
/.cloud

# Written by vite/streetmesh.js from what Composer has installed, on every dev
# server start and every build. Committing them would be committing a copy of
# the installed set, which is the thing they are derived from.
/resources/js/streetmesh.generated.js
/resources/css/streetmesh.generated.css

.env
.colyseus-cloud.json
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/auth.json
/.fleet
/.idea
/.nova
/.vscode
/.zed
plc/source

# macOS leaves these everywhere and nobody wants them in a repository.
.DS_Store
