{
    "name": "streetmesh/protocol-laravel",
    "description": "The StreetMesh protocol for Laravel: identity, records, and the bindings that make them usable.",
    "keywords": [
        "streetmesh",
        "laravel",
        "atproto",
        "did",
        "federation"
    ],
    "homepage": "https://protocol.streetmesh.com",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "streetmesh/protocol": "@dev"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../protocol",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Protocol-PHP.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "StreetMesh\\Protocol\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StreetMesh\\Protocol\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StreetMesh\\Protocol\\Laravel\\ProtocolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": "pint",
        "lint:check": "pint --test",
        "test": [
            "@lint:check",
            "@types:check",
            "phpunit"
        ],
        "types:check": "phpstan analyse"
    }
}
