{
    "name": "streetmesh/laravel-chess",
    "description": "Chess as a StreetMesh venue experience.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bacon/bacon-qr-code": "^3.1",
        "illuminate/support": "^12.0|^13.0",
        "livewire/flux": "^2.13",
        "livewire/livewire": "^4.1",
        "streetmesh/laravel-venue": "@dev",
        "streetmesh/protocol-laravel": "@dev"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../protocol-laravel",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../laravel-venue",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../protocol",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Laravel-Venue.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Protocol-Laravel.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/StreetMesh/Protocol-PHP.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "StreetMesh\\Chess\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StreetMesh\\Chess\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "StreetMesh\\Chess\\ChessServiceProvider"
            ]
        },
        "streetmesh": {
            "components": "resources/js/alpine.js",
            "views": "resources/views"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint:check": "pint --test",
        "types:check": "phpstan analyse",
        "test": [
            "@lint:check",
            "@types:check",
            "phpunit"
        ]
    }
}
