<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         colors="true">
    <testsuites>
        <testsuite name="chess">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <!-- Nowhere real, and never the public directory: an entry published
             there is permanent and global. The protocol refuses to write a
             local-only handle to it, which is what these tests would do. -->
        <env name="STREETMESH_PLC_DIRECTORY" value="https://plc.invalid"/>
    </php>
</phpunit>
