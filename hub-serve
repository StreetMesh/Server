#!/usr/bin/env bash
#
# Run this venue's hub, with whatever experiences it has installed.
#
#   ./hub-serve
#
# One of three things a working venue needs running: Herd serves the PHP, Vite
# serves the browser assets, and this serves the rooms. None of them starts the
# others, and a board that connects to nothing is usually this one missing.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Node does not read the system keychain, and the hub fetches the venue's DID
# document over TLS to check a ticket. Without this every ticket is refused for
# a reason that has nothing to do with the ticket.
export NODE_EXTRA_CA_CERTS="${NODE_EXTRA_CA_CERTS:-$HOME/Library/Application Support/Herd/config/valet/CA/LaravelValetCASelfSigned.pem}"

# The one thing the hub says to the venue with, read from the venue's own .env
# rather than kept a second time. Two copies of a shared secret are two things
# that can disagree, and the way you find out they have is that nothing
# happens.
#
# Read one key rather than sourcing the file: a .env holds values with spaces,
# hashes and quotes in them, and asking bash to interpret all of that to fetch
# one string is a way to be surprised.
if [ -f "$here/.env" ]; then
    STREETMESH_REALTIME_SECRET="$(
        grep -E '^[[:space:]]*STREETMESH_REALTIME_SECRET=' "$here/.env" \
            | tail -1 \
            | cut -d= -f2- \
            | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"\(.*\)"$/\1/' -e "s/^'\(.*\)'$/\1/"
    )"
    export STREETMESH_REALTIME_SECRET
fi

if [ -z "${STREETMESH_REALTIME_SECRET:-}" ]; then
    echo "No STREETMESH_REALTIME_SECRET in $here/.env." >&2
    echo "The hub needs the same value the venue has, or the venue will not believe it." >&2
    exit 1
fi

export PORT="${PORT:-2567}"

cd "$here"

# Built before it is started, so what runs here is the artifact that deploys
# rather than something assembled a second way. That is the whole point: "it
# works locally" has to be a statement about the thing that ships.
php artisan hub:build --quiet

build="$here/hub-build"

# The generated package brings its own dependencies — a room may need a chess
# engine, and the hub cannot know that. Installed only when the manifest has
# moved, because most builds change a room rather than what it depends on.
if [ ! -d "$build/node_modules" ] || [ "$build/package.json" -nt "$build/node_modules" ]; then
    (cd "$build" && npm install --silent)
fi

# What this hub is, so it can answer for itself. Read from the artifact rather
# than recomputed, so the two can never disagree.
HUB_BUILD="$(grep -o "HUB_BUILD: '[a-f0-9]*'" "$build/ecosystem.config.cjs" | cut -d"'" -f2)"
export HUB_BUILD

cd "$build"

exec node --experimental-strip-types index.ts
